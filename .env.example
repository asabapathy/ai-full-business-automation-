# ============================================================
# Kanavu AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# App
NODE_ENV=development
APP_NAME="Kanavu AI"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# Database
DATABASE_URL="postgresql://kanavu:kanavu_secret@localhost:5432/kanavu_db"
DATABASE_SHADOW_URL="postgresql://kanavu:kanavu_secret@localhost:5432/kanavu_shadow"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="change-this-to-a-very-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-very-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
SESSION_SECRET="change-this-session-secret"

# AI Providers
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
OPENAI_ORG_ID=""

# Vector Database (Pinecone)
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="kanavu-memory"

# Storage (S3-compatible)
STORAGE_PROVIDER="local"  # local | s3 | gcs
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="kanavu-uploads"
LOCAL_STORAGE_PATH="./uploads"

# Email
EMAIL_PROVIDER="smtp"  # smtp | sendgrid | resend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@kanavu.ai"
FROM_NAME="Kanavu AI"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Voice AI (Twilio + ElevenLabs)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Payment (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# Social Media APIs
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Monitoring
SENTRY_DSN=""
POSTHOG_KEY=""
LOG_LEVEL="info"

# Queue (BullMQ)
QUEUE_REDIS_URL="redis://localhost:6379"
QUEUE_CONCURRENCY=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature Flags
ENABLE_VOICE_AI=false
ENABLE_COMPETITOR_INTELLIGENCE=false
ENABLE_AI_WEBSITE_BUILDER=false
