// ============================================================
// Kanavu AI — Prisma Database Schema
// Production-ready multi-tenant SaaS schema
// ============================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_SHADOW_URL")
  extensions = [pgvector(map: "vector", schema: "extensions"), uuid_ossp(map: "uuid-ossp", schema: "extensions"), pg_trgm(schema: "extensions")]
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  AI_AGENT
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum IndustryType {
  DENTAL_CLINIC
  MEDICAL_PRACTICE
  HVAC
  PLUMBING
  ELECTRICAL
  ROOFING
  LANDSCAPING
  AUTO_REPAIR
  RESTAURANT
  SALON
  GYM
  LAW_FIRM
  INSURANCE_AGENCY
  REAL_ESTATE
  ACCOUNTING_FIRM
  AUTISM_THERAPY
  ABA_PROVIDER
  DAYCARE
  VETERINARY
  CLEANING_COMPANY
  ECOMMERCE
  RETAIL
  TECHNOLOGY
  CONSULTING
  OTHER
}

enum ContactType {
  LEAD
  PROSPECT
  CUSTOMER
  PARTNER
  VENDOR
  EMPLOYEE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
  UNQUALIFIED
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  NEEDS_ANALYSIS
  VALUE_PROPOSITION
  DECISION_MAKERS
  PERCEPTION_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELED
  WAITING_APPROVAL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum AIAgentType {
  BUSINESS_BRAIN
  RECEPTIONIST
  MARKETING
  SALES
  FINANCE
  OPERATIONS
  EMPLOYEE_ASSISTANT
  WEBSITE_BUILDER
  COMPETITOR_INTEL
  BUSINESS_DOCTOR
  AUTOMATION_BUILDER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum CampaignType {
  EMAIL
  SMS
  SOCIAL_FACEBOOK
  SOCIAL_INSTAGRAM
  SOCIAL_TIKTOK
  SOCIAL_LINKEDIN
  GOOGLE_ADS
  REFERRAL
  REVIEW_REQUEST
  LOYALTY
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELED
  RESCHEDULED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum WorkflowTriggerType {
  EVENT
  SCHEDULE
  WEBHOOK
  MANUAL
  AI_DECISION
  FORM_SUBMISSION
  CONTACT_CREATED
  CONTACT_UPDATED
  DEAL_STAGE_CHANGED
  APPOINTMENT_BOOKED
  INVOICE_OVERDUE
  REVIEW_RECEIVED
}

enum WorkflowStepType {
  SEND_EMAIL
  SEND_SMS
  MAKE_CALL
  CREATE_TASK
  UPDATE_CRM
  POST_SOCIAL
  WAIT_DELAY
  CONDITION_BRANCH
  AI_ACTION
  WEBHOOK
  NOTIFY_TEAM
  CREATE_INVOICE
  BOOK_APPOINTMENT
  ADD_TAG
  REMOVE_TAG
  ASSIGN_OWNER
}

enum MemoryType {
  EPISODIC
  SEMANTIC
  PROCEDURAL
  WORKING
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewPlatform {
  GOOGLE
  YELP
  FACEBOOK
  TRIPADVISOR
  BBB
  HEALTHGRADES
  ZOCDOC
  OTHER
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

// ============================================================
// CORE: ORGANIZATIONS & USERS (Multi-Tenant Foundation)
// ============================================================

model Organization {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String           @unique
  industry         IndustryType     @default(OTHER)
  logoUrl          String?
  website          String?
  phone            String?
  email            String?
  address          Json?
  timezone         String           @default("America/New_York")
  locale           String           @default("en-US")
  currency         String           @default("USD")
  aiPersonality    Json?
  businessHours    Json?
  settings         Json             @default("{}")
  onboardingStep   Int              @default(0)
  onboardingDone   Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  members          OrganizationMember[]
  subscription     Subscription?
  contacts         Contact[]
  companies        Company[]
  deals            Deal[]
  campaigns        Campaign[]
  appointments     Appointment[]
  invoices         Invoice[]
  workflows        Workflow[]
  aiTasks          AITask[]
  memories         Memory[]
  conversations    Conversation[]
  knowledgeItems   KnowledgeItem[]
  socialAccounts   SocialAccount[]
  websites         Website[]
  employees        Employee[]
  schedules        Schedule[]
  inventoryItems   InventoryItem[]
  vendors          Vendor[]
  competitors      Competitor[]
  reviews          Review[]
  automationRuns   WorkflowExecution[]
  featureFlags          OrganizationFeatureFlag[]
  apiKeys               ApiKey[]
  webhooks              Webhook[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  tags                  Tag[]
  customFields          CustomField[]
  dashboards            Dashboard[]
  locations             Location[]
  chatSessions          ChatSession[]
  customerSubscriptions CustomerSubscription[]
  brandConfig           BrandConfig?
  emailCampaigns        EmailCampaign[]
  outboundWebhooks      OutboundWebhook[]
  calendarIntegrations  CalendarIntegration[]
  leadScores            LeadScore[]
  reviewRequests        ReviewRequest[]
  proposals             Proposal[]
  smsConversations      SmsConversation[]
  shifts                Shift[]
  timeOffRequests       TimeOffRequest[]
  jobCostItems          JobCostItem[]
  followUpSequences     FollowUpSequence[]
  videoTestimonials     VideoTestimonial[]
  revenueForecasts      RevenueForecast[]
  callLogs              CallLog[]
  portalSessions        PortalSession[]
  emailThreads          EmailThread[]
  contentPosts          ContentPost[]
  commissionRules       CommissionRule[]
  commissionPayouts     CommissionPayout[]
  leadForms             LeadForm[]
  leadFormSubmissions   LeadFormSubmission[]
  chatWidgets           ChatWidget[]
  waitlistEntries       WaitlistEntry[]
  giftCards             GiftCard[]
  referralPrograms      ReferralProgram[]
  referrals             Referral[]
  documentTemplates     DocumentTemplate[]
  dripCampaigns         DripCampaign[]
  loyaltyAccounts       LoyaltyAccount[]
  intakeForms           IntakeForm[]
  resources             Resource[]
  paymentLinks          PaymentLink[]
  emailBroadcasts       EmailBroadcast[]
  pushSubscriptions     PushSubscriptionRecord[]
  whatsAppMessages      WhatsAppMessage[]
  csatSurveys           CsatSurvey[]
  calendarFeeds         CalendarFeed[]
  aiEmailDrafts         AiEmailDraft[]
  projects              Project[]
  timeEntries           TimeEntry[]
  estimates             Estimate[]
  contracts             Contract[]
  goals                 Goal[]
  emailTemplates        EmailTemplate[]
  onboardingChecklists  OnboardingChecklist[]
  activities            Activity[]

  @@index([slug])
  @@index([industry])
  @@map("organizations")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  emailVerified   Boolean   @default(false)
  passwordHash    String?
  firstName       String
  lastName        String
  avatarUrl       String?
  phone           String?
  timezone        String    @default("America/New_York")
  locale          String    @default("en-US")
  preferences     Json      @default("{}")
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)
  isSuperAdmin    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  memberships     OrganizationMember[]
  sessions        Session[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  assignedTasks   AITask[]           @relation("TaskAssignee")
  createdTasks    AITask[]           @relation("TaskCreator")
  ownedDeals      Deal[]
  ownedContacts   Contact[]
  conversations   Conversation[]

  @@index([email])
  @@map("users")
}

model OrganizationMember {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  role           UserRole  @default(MEMBER)
  permissions    Json      @default("{}")
  invitedBy      String?   @db.Uuid
  invitedAt      DateTime?
  joinedAt       DateTime  @default(now())
  isActive       Boolean   @default(true)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================
// BILLING & SUBSCRIPTIONS
// ============================================================

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @unique @db.Uuid
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  seats                Int                @default(5)
  aiCallsPerMonth      Int                @default(100)
  storageGb            Int                @default(5)
  metadata             Json               @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices             BillingInvoice[]
  usageRecords         UsageRecord[]

  @@map("subscriptions")
}

model BillingInvoice {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @db.Uuid
  stripeId       String?  @unique
  amount         Int
  currency       String   @default("usd")
  status         String
  paidAt         DateTime?
  invoiceUrl     String?
  createdAt      DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_invoices")
}

model UsageRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @db.Uuid
  metric         String
  quantity       Int
  recordedAt     DateTime @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, metric])
  @@map("usage_records")
}

// ============================================================
// AI BRAIN: MEMORY & KNOWLEDGE
// ============================================================

model Memory {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @db.Uuid
  type           MemoryType @default(EPISODIC)
  content        String     @db.Text
  summary        String?    @db.Text
  sourceType     String?
  sourceId       String?
  embedding      Unsupported("vector(1536)")?
  metadata       Json       @default("{}")
  importance     Float      @default(0.5)
  accessCount    Int        @default(0)
  lastAccessedAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([sourceType, sourceId])
  @@map("memories")
}

model KnowledgeItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  title          String
  content        String   @db.Text
  category       String?
  tags           String[] @default([])
  embedding      Unsupported("vector(1536)")?
  fileUrl        String?
  fileType       String?
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdBy      String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, category])
  @@map("knowledge_items")
}

// ============================================================
// AI CONVERSATIONS & AGENTS
// ============================================================

model Conversation {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  userId         String?     @db.Uuid
  contactId      String?     @db.Uuid
  agentType      AIAgentType @default(BUSINESS_BRAIN)
  channel        String      @default("web")
  title          String?
  summary        String?     @db.Text
  status         String      @default("active")
  metadata       Json        @default("{}")
  startedAt      DateTime    @default(now())
  endedAt        DateTime?
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
  contact        Contact?     @relation(fields: [contactId], references: [id])
  messages       Message[]

  @@index([organizationId])
  @@index([userId])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String      @db.Text
  toolCalls      Json?
  toolResults    Json?
  tokensUsed     Int?
  model          String?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model AITask {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  createdById    String?      @db.Uuid
  assignedToId   String?      @db.Uuid
  agentType      AIAgentType
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(PENDING)
  priority       TaskPriority @default(MEDIUM)
  input          Json         @default("{}")
  output         Json?
  error          String?      @db.Text
  retryCount     Int          @default(0)
  maxRetries     Int          @default(3)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  dueAt          DateTime?
  metadata       Json         @default("{}")
  parentTaskId   String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User?        @relation("TaskCreator", fields: [createdById], references: [id])
  assignee       User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  parentTask     AITask?      @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks       AITask[]     @relation("SubTasks")

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, agentType])
  @@map("ai_tasks")
}

model AIDecision {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  agentType      AIAgentType
  context        Json
  decision       String   @db.Text
  reasoning      String   @db.Text
  confidence     Float    @default(0.0)
  outcome        String?
  approved       Boolean?
  approvedById   String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, agentType])
  @@map("ai_decisions")
}

// ============================================================
// CRM: CONTACTS, COMPANIES, DEALS
// ============================================================

model Contact {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  ownerId        String?     @db.Uuid
  companyId      String?     @db.Uuid
  type           ContactType @default(LEAD)
  status         LeadStatus  @default(NEW)
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  mobile         String?
  avatarUrl      String?
  jobTitle       String?
  address        Json?
  source         String?
  score          Int         @default(0)
  tags           String[]    @default([])
  customFields   Json        @default("{}")
  lastContactedAt DateTime?
  doNotEmail     Boolean     @default(false)
  doNotCall      Boolean     @default(false)
  doNotSms       Boolean     @default(false)
  notes          String?     @db.Text
  embedding      Unsupported("vector(1536)")?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation(fields: [ownerId], references: [id])
  company        Company?     @relation(fields: [companyId], references: [id])
  deals                 Deal[]
  activities            Activity[]
  appointments          Appointment[]
  invoices              Invoice[]
  conversations         Conversation[]
  tags_rel              ContactTag[]
  customerSubscriptions CustomerSubscription[]
  leadScore             LeadScore?
  reviewRequests        ReviewRequest[]
  proposals             Proposal[]
  followUpEnrollments   FollowUpEnrollment[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([email])
  @@map("contacts")
}

model Company {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  website        String?
  phone          String?
  email          String?
  industry       String?
  size           String?
  revenue        Decimal? @db.Decimal(15, 2)
  address        Json?
  logoUrl        String?
  description    String?  @db.Text
  customFields   Json     @default("{}")
  tags           String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]

  @@index([organizationId])
  @@map("companies")
}

model Deal {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  ownerId        String?   @db.Uuid
  contactId      String?   @db.Uuid
  companyId      String?   @db.Uuid
  title          String
  stage          DealStage @default(PROSPECTING)
  value          Decimal   @default(0) @db.Decimal(15, 2)
  currency       String    @default("USD")
  probability    Int       @default(0)
  expectedCloseDate DateTime?
  closedAt       DateTime?
  lostReason     String?
  notes          String?   @db.Text
  customFields   Json      @default("{}")
  tags           String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation(fields: [ownerId], references: [id])
  contact        Contact?     @relation(fields: [contactId], references: [id])
  company        Company?     @relation(fields: [companyId], references: [id])
  activities     Activity[]
  quotes         Quote[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([ownerId])
  @@map("deals")
}

model Activity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  contactId      String?  @db.Uuid
  companyId      String?  @db.Uuid
  dealId         String?  @db.Uuid
  type           String
  subject        String
  description    String?  @db.Text
  outcome        String?
  dueAt          DateTime?
  completedAt    DateTime?
  duration       Int?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?  @relation(fields: [contactId], references: [id])
  company        Company?  @relation(fields: [companyId], references: [id])
  deal           Deal?     @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
  @@map("activities")
}

model Quote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  dealId         String?  @db.Uuid
  contactId      String?  @db.Uuid
  number         String
  title          String
  status         String   @default("draft")
  lineItems      Json     @default("[]")
  subtotal       Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(15, 2)
  discountAmount Decimal  @default(0) @db.Decimal(15, 2)
  total          Decimal  @default(0) @db.Decimal(15, 2)
  currency       String   @default("USD")
  validUntil     DateTime?
  notes          String?  @db.Text
  terms          String?  @db.Text
  pdfUrl         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deal           Deal?    @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@map("quotes")
}

// ============================================================
// APPOINTMENTS & SCHEDULING
// ============================================================

model Appointment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  contactId      String?           @db.Uuid
  employeeId     String?           @db.Uuid
  serviceId      String?           @db.Uuid
  title          String
  description    String?
  status         AppointmentStatus @default(SCHEDULED)
  startTime      DateTime
  endTime        DateTime
  duration       Int
  location       String?
  meetingUrl     String?
  color          String?
  notes          String?           @db.Text
  reminders      Json              @default("[]")
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  recurrenceRule     String?
  recurrenceParentId String?   @db.Uuid
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id])
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  service        Service?     @relation(fields: [serviceId], references: [id])
  recurrenceChildren Appointment[] @relation("RecurrenceParent")
  recurrenceParent   Appointment?  @relation("RecurrenceParent", fields: [recurrenceParentId], references: [id])

  @@index([organizationId])
  @@index([organizationId, startTime])
  @@index([employeeId, startTime])
  @@index([recurrenceParentId])
  @@map("appointments")
}

model Service {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
