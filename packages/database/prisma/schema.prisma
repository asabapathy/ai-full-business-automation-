  total          Decimal      @default(0) @db.Decimal(15, 2)
  currency       String       @default("USD")
  notes          String?
  validUntil     DateTime?
  sentAt         DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("estimates")
}

